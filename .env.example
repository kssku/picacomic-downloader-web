# ════════════════════════════════════════════════════════════════════
#  pica-server 环境变量示例
#
#  用法：复制成 .env 放在 docker-compose.yml 旁边，按需修改。
#      cp .env.example .env
#
#  .env 里会存明文 Token，不要提交到 Git。
# ════════════════════════════════════════════════════════════════════

# ── 访问认证 ────────────────────────────────────────────────────────
# 登录口令。留空 = 首次启动时随机生成，并打印在容器日志里：
#     docker compose logs pica-server | grep 访问令牌
# （注意横幅里写的是中文「访问令牌」，grep Token 是搜不到的）
# 拿到后建议填回这里固定下来，否则容器重建会换一个新的。
# 也可以直接用浏览器 Basic Auth 登录：用户名见下，密码就是这串 Token。
PICA_AUTH_TOKEN=

# Basic Auth 的用户名。用 Bearer Token 方式登录时此项无意义。
PICA_AUTH_USER=admin

# 是否关闭访问认证。设为 true / 1 时所有请求直接放行，无需 Token。
# ⚠ 仅在完全可信的内网使用；一旦暴露到公网，任何人都能访问。
PICA_AUTH_DISABLED=false


# ── 端口 ────────────────────────────────────────────────────────────
# NAS 上对外暴露的端口。被占用（比如群晖 / 飞牛的 Web 管理端口）就改这里，
# 例如 18080。容器内部始终监听 8080，不用改。
PICA_HOST_PORT=8080


# ── 数据目录 ────────────────────────────────────────────────────────
# 配置、日志、下载的漫画全部落在这个宿主机目录里。
# 强烈建议指向 NAS 存储池上的真实路径，而不是默认的相对目录 ./data，
# 这样漫画就是普通文件，方便快照、备份、直接用文件管理器浏览。
#
# 飞牛 NAS 示例（改成你自己的存储池路径）：
#   PICA_DATA_PATH=/vol1/1000/docker/pica-server
PICA_DATA_PATH=./data


# ── 漫画下载目录 ────────────────────────────────────────────────────
# 单独挂载漫画下载目录，让下载产物直接落进后处理流水线
# （pica_postprocess.py 扫描的源目录），实现全自动：
#     下载 → 打包 CBZ → 上传 115
#
# 配合使用：把容器内 config.json 的 downloadDir 改成 /comic-download
# （首次启动后改，或在网页「配置」里改）。
#
# 留空 = 不单独挂载，沿用 /data/漫画下载（不接后处理流水线）。
#
# 飞牛 NAS 示例（接你自己的后处理目录）：
#   PICA_COMIC_PATH=/vol1/1000/comic/pika/comic
PICA_COMIC_PATH=./comic-download


# ── 时区 ────────────────────────────────────────────────────────────
# 影响日志时间戳和「下载目录日期模板」里的日期。
TZ=Asia/Shanghai


# ── 运行期代理（可选，但国内几乎必填）────────────────────────────────
# 只在容器运行时生效，不影响构建。与下面的 BUILD_*_PROXY 是两回事。
#
# 什么时候需要：NAS 直连哔咔 API（picaapi.picacomic.com）和图片 CDN
# 不通时必须配，否则网页能打开、能登录，但下载会全部超时。
#
# 自测方法（在 NAS 上执行）：
#   curl -sS -o /dev/null -w '%{http_code}\n' https://picaapi.picacomic.com/
#     无输出 / 超时 = 直连不通，需要配代理
#     返回 400      = 通了（400 是哔咔对无签名裸请求的正常拒绝，不是故障）
#
# 推荐写法：用 host.docker.internal，compose 已配好映射到宿主机，
# 这样换 NAS 或改 IP 时不用动这个文件。
#   PICA_HTTP_PROXY=http://host.docker.internal:7890
#   PICA_HTTPS_PROXY=http://host.docker.internal:7890
#
# 也可以直接写 NAS 的局域网 IP（当前是 192.168.31.124）：
#   PICA_HTTP_PROXY=http://192.168.31.124:7890
#
# ⚠ 不要写 127.0.0.1 —— 容器里的 127.0.0.1 指向容器自身，不是宿主机。
#
# 留空 = 直连（适用于能直连哔咔的网络环境）。
PICA_HTTP_PROXY=
PICA_HTTPS_PROXY=


# ── 构建期代理（可选，但国内几乎必填）────────────────────────────────
# 只在 `docker compose build` 时生效，不会进入运行期容器。
#
# 为什么需要：构建要下载 npm 依赖（registry.npmjs.org）和 Rust 依赖
# （crates.io / github.com）。国内直连这几个域名通常不通，构建会长时间
# 卡住然后失败，报错还很难看懂（多为 network timeout / connection reset）。
#
# 填什么：宿主机上可用的 HTTP 代理地址。
# ⚠ 必须用宿主机的局域网 IP，不能用 127.0.0.1 —— 构建阶段的容器不在
#   自定义网络里，host.docker.internal 不可用，只能写真实 IP。
#
# 示例（NAS IP 为 192.168.31.124，代理监听 7890）：
#   BUILD_HTTP_PROXY=http://192.168.31.124:7890
#   BUILD_HTTPS_PROXY=http://192.168.31.124:7890
#
# 留空 = 直连。如果你的网络能直连上述域名，就不用填。
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=