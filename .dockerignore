# ── 构建产物：镜像内会重新生成，绝不要从宿主机带进去 ──────────
node_modules
**/node_modules
dist
dist-ssr
src-server/target
src-tauri/target

# 运行期数据：由 volume 挂载，不进镜像
data
logs
*.log

# 桌面版（Tauri）外壳：Web 版完全用不到，留着只会拖慢构建上下文
src-tauri

# 无关文档与大文件
project_code_summary.txt
README.md
DOCKER.md
.env.example
LICENSE

# 本地环境变量：可能含明文 Token，绝不能进构建上下文
.env
.env.*
!.env.example

# 编辑器 / VCS / 系统垃圾
.git
.gitignore
.github
.vscode
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# 锁文件：只保留 pnpm-lock.yaml，避免 npm/pnpm 混用导致依赖树不一致
package-lock.json